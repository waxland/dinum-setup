{
  "name": "@suitenumerique/blocknote-sources",
  "version": "1.0.0",
  "description": "Official BlockNote.js extension connecting La Suite Docs to sovereign public data sources with 100% Cunningham and DSFR rendering.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./exporters": {
      "types": "./dist/exporters/index.d.ts",
      "import": "./dist/exporters/index.mjs",
      "require": "./dist/exporters/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "waxland",
  "license": "MIT",
  "homepage": "https://github.com/waxland/dinum-setup/tree/main/packages/blocknote-sources",
  "repository": {
    "type": "git",
    "url": "https://github.com/waxland/dinum-setup.git",
    "directory": "packages/blocknote-sources"
  },
  "bugs": {
    "url": "https://github.com/waxland/dinum-setup/issues"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npx vitest run tests/unit/",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "blocknote",
    "custom-block",
    "lasuite",
    "dinum",
    "cunningham",
    "dsfr",
    "sources-souveraines",
    "legifrance",
    "ban",
    "boamp",
    "insee",
    "albert"
  ],
  "peerDependencies": {
    "@blocknote/core": ">=0.54.0",
    "@blocknote/react": ">=0.54.0",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "styled-components": ">=6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^8.6.18",
    "styled-components": "^6.1.15",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2"
  }
}
