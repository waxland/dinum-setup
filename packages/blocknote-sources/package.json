{
  "name": "@suitenumerique/blocknote-sources",
  "version": "1.0.0",
  "description": "Official BlockNote.js extension connecting La Suite Docs to sovereign public data sources with 100% Cunningham and DSFR rendering.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./exporters": {
      "types": "./dist/exporters/index.d.ts",
      "import": "./dist/exporters/index.mjs",
      "require": "./dist/exporters/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": "DINUM",
  "license": "MIT",
  "repository": "https://github.com/suitenumerique/docs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npx vitest run tests/unit/",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "blocknote",
    "custom-block",
    "lasuite",
    "dinum",
    "cunningham",
    "dsfr",
    "sources-souveraines",
    "legifrance",
    "ban",
    "boamp",
    "insee",
    "albert"
  ],
  "peerDependencies": {
    "@blocknote/core": ">=0.54.0",
    "@blocknote/react": ">=0.54.0",
    "react": ">=18.0.0 || >=19.0.0",
    "react-dom": ">=18.0.0 || >=19.0.0",
    "styled-components": ">=6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "styled-components": "^6.1.15",
    "tsup": "^8.3.6",
    "typescript": "^5.9.2"
  }
}
