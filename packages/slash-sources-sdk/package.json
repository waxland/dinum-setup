{
  "name": "@suitenumerique/slash-sources-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for fast creation and integration of sovereign data sources into La Suite Numérique",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npx vitest run"
  },
  "keywords": [
    "dinum",
    "lasuite",
    "blocknote",
    "slash-commands",
    "sovereign-sources",
    "cunningham",
    "dsfr",
    "sdk"
  ],
  "author": "Vguerand",
  "license": "MIT",
  "repository": "https://github.com/suitenumerique/docs",
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^2.1.8"
  }
}
