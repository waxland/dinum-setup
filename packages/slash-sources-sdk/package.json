{
  "name": "@suitenumerique/slash-sources-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for fast creation and integration of sovereign data sources into La Suite Numérique",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "author": "waxland",
  "license": "MIT",
  "homepage": "https://github.com/waxland/dinum-setup/tree/main/packages/slash-sources-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/waxland/dinum-setup.git",
    "directory": "packages/slash-sources-sdk"
  },
  "bugs": {
    "url": "https://github.com/waxland/dinum-setup/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "dinum",
    "lasuite",
    "blocknote",
    "slash-commands",
    "sovereign-sources",
    "cunningham",
    "dsfr",
    "sdk",
    "dpga",
    "open-data"
  ],
  "devDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^5.9.2",
    "vitest": "4.1.11"
  }
}
