{
  "name": "dinum-setup-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:nav": "node scripts/generate-docs-navigation.mjs",
    "dev": "node scripts/generate-docs-navigation.mjs && ZUDOKU_DISABLE_UPDATE_CHECK=1 zudoku dev --host 0.0.0.0",
    "docs:dev": "node scripts/generate-docs-navigation.mjs && ZUDOKU_DISABLE_UPDATE_CHECK=1 zudoku dev --host 0.0.0.0",
    "docs:build": "node scripts/generate-docs-navigation.mjs && ZUDOKU_DISABLE_UPDATE_CHECK=1 zudoku build",
    "docs:preview": "ZUDOKU_DISABLE_UPDATE_CHECK=1 zudoku preview --host 0.0.0.0",
    "build": "npm run docs:build"
  },
  "dependencies": {
    "mermaid": "^11.17.2",
    "zudoku": "^0.86.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
